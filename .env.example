# ---- Gemini ----
# Comma-separated keys enable rotation. Free-tier quota is metered per model
# per project, so extra keys only help if they come from different projects.
GEMINI_API_KEYS=key_one_here,key_two_here
GEMINI_API_KEY=your_gemini_api_key_here

# Classification model. Pro models are metered at zero on the free tier.
GEMINI_INTERNSHIPS_MODEL=gemini-flash-lite-latest

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional overrides if this bot has its own token/channel.
TELEGRAM_INTERNSHIPS_BOT_TOKEN=
TELEGRAM_INTERNSHIPS_CHAT_ID=
